# Copy to .env on the Pi (and the laptop). Same Supabase project for both.
# Shared pooler: session 5432 for migrations, transaction 6543 for the app.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=

# Host port published as http://<pi>:3000 (Cloudflare tunnel points here).
SWEEPY_PORT=3000

# Pi backup sidecar dumps Postgres to gdrive:backups/sweepy via the host rclone
# login at ~/.config/rclone (same [gdrive] remote as actual-helpers).
# Sidecar runs as uid 1000 so it does not rewrite rclone.conf as root.

# Household timezone — midnight assign and "today" follow this, not UTC.
TZ=America/Chicago

# Sweepy → Home Assistant (morning notifies). One house token, not per person.
# HA → Profile → Long-lived access tokens → Create token
# Leave these unquoted. Docker keeps the quotes if you wrap the token.
HA_URL=http://host.docker.internal:8123
HA_TOKEN=

# Same Mosquitto as Zigbee2MQTT / HA (anonymous, no user). Sweepy Docker → Pi host.
MQTT_URL=mqtt://host.docker.internal:1883
