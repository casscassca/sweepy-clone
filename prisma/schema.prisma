generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🏠")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id            String   @id @default(cuid())
  name          String
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  difficulty    Int      @default(1)
  frequencyDays Int      @default(7)
  allowedDays   String?
  lastDoneAt    DateTime?
  oneOff        Boolean  @default(false)
  important     Boolean  @default(false)
  dueOnly       Boolean  @default(false)
  notes         String   @default("")
  addonName           String    @default("")
  addonFrequencyDays  Int       @default(0)
  addonPoints         Int       @default(1)
  addonLastDoneAt     DateTime?
  addon2Name          String    @default("")
  addon2FrequencyDays Int       @default(0)
  addon2Points        Int       @default(1)
  addon2LastDoneAt    DateTime?
  createdAt     DateTime @default(now())
  assignableUsers TaskAssignableUser[]
  assignments     DailyAssignment[]
  completions     CompletionLog[]
}

model TaskAssignableUser {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model User {
  id             String   @id @default(cuid())
  name           String
  haNotifyTarget String   @default("")
  dailyCapacity  Int      @default(6)
  dailyTaskLimit Int      @default(6)
  weekdayCapacities String @default("")
  weekdayTaskLimits String @default("")
  weekendShare     Boolean @default(true)
  weekendCapacity  Int     @default(6)
  weekendTaskLimit Int     @default(4)
  notifyTime     String   @default("08:00")
  nudgeTime      String   @default("")
  color          String   @default("#6366f1")
  createdAt      DateTime @default(now())
  // Auth: scrypt password hash (null = no password set, cannot log in yet).
  passwordHash   String?
  // Per-user secret for the Home Assistant webhook — both authorizes the call
  // and identifies who acted (so completions credit the right person).
  webhookSecret  String   @default("")
  // Assignment ids last pushed to this person's phone, so we can dismiss them.
  notifyTags     String   @default("")
  vacationOn     Boolean  @default(false)
  vacationStart  String   @default("")
  vacationEnd    String   @default("")
  assignableTasks TaskAssignableUser[]
  assignments     DailyAssignment[]
  completions     CompletionLog[]
  completedFor    CompletionLog[]      @relation("CompletedFor")
}

model DailyAssignment {
  id            String    @id @default(cuid())
  date          String
  userId        String
  taskId        String
  order         Int       @default(0)
  completedAt   DateTime?
  completedById String?
  remindAt      DateTime?
  // True when someone put it on this day (drag, Tomorrow). Survives auto top-up
  // and can push a day over capacity. Re-assign still forgets it unless pinned.
  held          Boolean   @default(false)
  // Stays on this day through Re-assign. Outranks one-offs when a day is stuffed.
  pinned        Boolean   @default(false)
  parked        Boolean   @default(false)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([date, taskId])
  @@index([date])
}

model CompletionLog {
  id            String   @id @default(cuid())
  taskId        String
  userId        String
  completedById String?
  completedAt   DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedBy   User?    @relation("CompletedFor", fields: [completedById], references: [id], onDelete: Cascade)
}

model Settings {
  id        String @id @default("singleton")
  haUrl     String @default("")
  haToken   String @default("")
  darkMode  Boolean @default(false)
  // Secret used to sign session cookies. Generated once on first use and kept
  // in the DB so it persists across deploys (the data volume) and never lives in git.
  sessionSecret String @default("")
  weekendShare     Boolean @default(true)
  weekendCapacity  Int     @default(6)
  weekendTaskLimit Int     @default(4)
  houseVacation      Boolean @default(false)
  houseVacationStart String  @default("")
  houseVacationEnd   String  @default("")
  pauseDirtiness     Boolean @default(false)
  dirtFrozenOn       String  @default("")
  backupAt           DateTime?
}

model IntegrationLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String
  ok        Boolean
  userName  String   @default("")
  summary   String
  detail    String   @default("")

  @@index([createdAt])
}
